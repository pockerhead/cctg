+            let batch: Vec<Value> = self
+                .0
+                .iter()
+                .filter(|update| update["update_id"].as_i64().unwrap_or_default() >= confirmed)
+                .cloned()
+                .collect();
+            if batch.is_empty() {
+                tokio::time::sleep(timeout).await;
+            }
+            Ok(batch)
+        }
+    }
