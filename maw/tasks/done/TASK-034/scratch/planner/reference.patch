new file mode 100644
index 0000000..ad0e573
--- /dev/null
+++ b/crates/cctg/tests/hub_reads_no_files.rs
@@ -0,0 +1,73 @@
+//! The hub opens no file of a session's machine (TASK-034): outside its own
+//! state (`registry.json`, the `getUpdates` offset, the `.env` it starts
+//! with) and its test helpers, no file API appears in the non-test code of
+//! `src/hub/`. Session files are read by the session's agent
+//! (`crate::reads`, `crate::tail`), which the hub only asks over the link.
+
+use std::path::Path;
+
+/// Files that keep the hub's own state; anything else must not touch files.
+const OWN_STATE: [&str; 4] = ["config.rs", "offset.rs", "registry.rs", "testdir.rs"];
+
+/// What opening, listing or reading a file looks like, and the agent-side
+/// readers the hub must not call.
+const FORBIDDEN: [&str; 9] = [
+    "std::fs",
+    "tokio::fs",
+    "File::",
+    "OpenOptions",
+    "read_dir",
+    "read_to_string",
+    "canonicalize",
+    "crate::tail",
+    "reads::answer",
+];
+
+/// The code before the file's `#[cfg(test)]` module.
+fn production(source: &str) -> &str {
+    source
+        .find("#[cfg(test)]\nmod tests")
+        .map_or(source, |at| &source[..at])
+}
+
+#[test]
+fn hub_sources_read_no_session_files() {
+    let dir = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("src")
+        .join("hub");
+    let mut checked = 0;
+    let mut found = Vec::new();
+    for entry in std::fs::read_dir(&dir).expect("src/hub") {
+        let path = entry.expect("entry").path();
+        let name = path.file_name().unwrap().to_string_lossy().into_owned();
+        if !name.ends_with(".rs") || OWN_STATE.contains(&name.as_str()) {
+            continue;
+        }
+        let source = std::fs::read_to_string(&path)
+            .expect("source")
+            .replace("\r\n", "\n");
+        checked += 1;
+        for (number, line) in production(&source).lines().enumerate() {
+            let code = line.split("//").next().unwrap_or_default();
+            for token in FORBIDDEN {
+                if code.contains(token) {
+                    found.push(format!("{name}:{}: {}", number + 1, line.trim()));
+                }
+            }
+        }
+    }
+    assert!(checked >= 14, "only {checked} hub sources found");
+    assert!(
+        found.is_empty(),
+        "file access in the hub:\n{}",
+        found.join("\n")
+    );
+}
+
+#[test]
+fn the_guard_sees_a_file_read() {
+    let source = "fn f() { let _ = std::fs::read(\"x\"); }\n#[cfg(test)]\nmod tests {}\n";
+    assert!(production(source).contains("std::fs"));
+    let only_tests = "fn f() {}\n#[cfg(test)]\nmod tests { fn g() { std::fs::read(\"x\"); } }\n";
+    assert!(!production(only_tests).contains("std::fs"));
+}
