+        // Another agent's name, a file beside `subagents`, and `..`.
+        let session_dir = root(&dir).join("C--proj").join(SESSION);
+        let beside = session_dir.join(format!("agent-{AGENT}.jsonl"));
+        std::fs::write(&beside, SUBAGENT).unwrap();
+        let renamed = session_dir
+            .join("subagents")
+            .join("agent-a0000000000000009.jsonl");
+        std::fs::write(&renamed, SUBAGENT).unwrap();
+        let dotdot = session_dir
+            .join("subagents")
+            .join("..")
+            .join(format!("agent-{AGENT}.jsonl"));
+        for path in [&beside, &renamed, &dotdot] {
