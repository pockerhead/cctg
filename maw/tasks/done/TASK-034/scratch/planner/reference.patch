+    #[test]
+    fn a_missing_or_foreign_transcript_is_missing() {
+        let dir = TempDir::new("reads-missing");
+        let path = transcript(&dir, SESSION, PARENT);
+        let brief = || render_ask(TranscriptView::Brief, 3);
+        // Another session's id, a traversal id, no root.
+        assert_eq!(ask(&dir, OTHER, &path, brief()), [SessionAnswer::Missing]);
+        assert_eq!(ask(&dir, "../x", &path, brief()), [SessionAnswer::Missing]);
+        assert_eq!(
+            answer(None, SESSION, &path, brief()),
+            [SessionAnswer::Missing]
+        );
+        // The right name outside the root, and through `..`.
+        let outside = dir.path().join("elsewhere").join("C--proj");
+        std::fs::create_dir_all(&outside).unwrap();
+        let foreign = outside.join(format!("{SESSION}.jsonl"));
+        std::fs::write(&foreign, PARENT).unwrap();
+        assert_eq!(
+            ask(&dir, SESSION, &foreign.to_string_lossy(), brief()),
+            [SessionAnswer::Missing]
+        );
+        let dotdot = root(&dir)
+            .join("C--proj")
+            .join("..")
+            .join("..")
+            .join("elsewhere")
+            .join("C--proj")
+            .join(format!("{SESSION}.jsonl"));
+        for kind in [
+            brief(),
+            SessionAsk::Title { from: 0 },
+            SessionAsk::Calls { from: 0 },
+        ] {
+            assert_eq!(
+                ask(&dir, SESSION, &dotdot.to_string_lossy(), kind),
+                [SessionAnswer::Missing]
+            );
+        }
+        // A directory named like a transcript is not one.
+        let fake = root(&dir).join("C--proj").join(format!("{OTHER}.jsonl"));
+        std::fs::create_dir_all(&fake).unwrap();
+        assert_eq!(
+            ask(&dir, OTHER, &fake.to_string_lossy(), brief()),
+            [SessionAnswer::Missing]
+        );
+        // An ask of a newer hub.
+        assert_eq!(
+            ask(&dir, SESSION, &path, SessionAsk::Other),
+            [SessionAnswer::Unsupported]
+        );
+    }
