+    async fn fetched(slots: &mut Slots, done: &mut mpsc::UnboundedReceiver<Done>) {
+        let finished = tokio::time::timeout(WAIT, done.recv())
+            .await
+            .expect("a download answer in time")
+            .expect("download task alive");
+        slots.on_done(finished);
+        slots.pump();
+    }
