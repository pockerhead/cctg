+                kind: FileKind::Photo,
+                file_id: "large".into(),
+                name: None,
+                mime_type: None,
+                size: Some(90000),
+            }
+        );
+        let kind = |extra: Value| {
+            input(extra)
+                .media
+                .map(|media| (media.file.kind, media.file.file_id))
+        };
+        let info = |id: &str| json!({ "file_id": id, "file_unique_id": "u", "file_name": "n.bin", "file_size": 5 });
