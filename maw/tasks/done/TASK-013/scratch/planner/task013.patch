+        let addr = listener.local_addr().unwrap();
+        let (outbox, events) = spawn(config(addr, Backoff::default()));
+        let (frames, frames_rx) = mpsc::channel(4);
+        let (ours, _theirs) = tokio::io::duplex(1024);
+        let serving = tokio::spawn(serve_channel(
+            frames_rx,
+            ours,
