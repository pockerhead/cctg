+    async fn agent_line(reader: &mut BufReader<OwnedReadHalf>) -> AgentMsg {
+        let mut line = Vec::new();
+        tokio::time::timeout(WAIT, wire::read_line(reader, &mut line))
+            .await
+            .expect("a line in time")
+            .unwrap();
+        wire::decode(&line).unwrap()
+    }
