+    /// Five letters without `l`, distinct for every `n` below 25^5.
+    fn request_id(mut n: usize) -> String {
+        const LETTERS: &[u8] = b"abcdefghijkmnopqrstuvwxyz";
+        let mut id = String::new();
+        for _ in 0..5 {
+            id.push(LETTERS[n % LETTERS.len()] as char);
+            n /= LETTERS.len();
+        }
+        id
+    }
