+    fn edits_of(ops: &[Op], message: i64) -> Vec<(String, Option<serde_json::Value>)> {
+        ops.iter()
+            .filter_map(|op| match op {
+                Op::Edit {
+                    message_id,
+                    text,
+                    reply_markup,
+                } if *message_id == message => Some((text.clone(), reply_markup.clone())),
+                _ => None,
+            })
+            .collect()
+    }
