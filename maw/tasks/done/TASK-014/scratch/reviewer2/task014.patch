+                conn,
+                "verdict ack from an agent of another session; ignored"
+            );
+            return;
+        }
+        info!(
+            conn,
+            session = short(&prompt.session),
+            "permission verdict taken by the session agent"
+        );
+        self.finish(key, State::Decided(behavior));
+    }
