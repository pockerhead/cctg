+    /// its ack; for an older agent the hand-off is all there is to know.
+    /// `false`: no agent of the session could take it now.
+    fn push_verdict(&mut self, key: u64) -> bool {
+        let Some(prompt) = self.prompts.get(key) else {
+            return false;
+        };
