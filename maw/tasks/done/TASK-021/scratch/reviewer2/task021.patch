+
+    #[tokio::test]
+    async fn an_ended_session_gets_no_inbound_even_with_its_agent_still_linked() {
+        let mut rig = rig(Fake::default(), message_options());
+        two_live_slots(&mut rig, false).await;
+        rig.hook(hook(
+            A,
