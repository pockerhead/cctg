+            .iter()
+            .find(|(_, entry)| {
+                entry.parent_session == session
+                    && entry.block.message_id == Some(message_id)
+                    && entry.block.thread_id == Some(thread_id)
+            })
+            .map(|(id, _)| id.as_str())
     }
 
