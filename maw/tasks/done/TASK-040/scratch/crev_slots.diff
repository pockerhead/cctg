+    fn answer(slots: &mut Slots, conn: u64, update_id: u64, outcome: UpdateOutcome) {
+        slots.on_agent(AgentEvent::Message {
+            conn,
+            received_at: StdInstant::now(),
+            msg: AgentMsg::UpdateAnswer { update_id, outcome },
+        });
