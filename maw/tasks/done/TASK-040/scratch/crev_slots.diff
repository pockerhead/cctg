+    fn register_client(
+        slots: &mut Slots,
+        conn: u64,
+        client: Option<Client>,
+    ) -> mpsc::Receiver<HubMsg> {
+        let (to_agent, from_hub) = mpsc::channel(8);
+        slots.on_agent(AgentEvent::Registered {
+            conn,
+            register: Register {
+                session_id: A.into(),
+                host: "box".into(),
+                cwd: CWD.into(),
+                claude_pid: Some(10),
+                verdict_ack: false,
+                transcript_reads: false,
+                console_keys: true,
