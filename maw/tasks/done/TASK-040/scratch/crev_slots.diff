+    /// A live session A in slot 0 with topic 100; the hub runs `HUB_BUILD`.
+    fn updating_slots(dir: &TempDir) -> (Arc<Fake>, Slots) {
+        let options = Options {
+            build: Some(HUB_BUILD.into()),
+            ..options()
+        };
+        let (fake, mut slots) = live_slots(dir, options);
+        slots.on_hook(&start(A, 10));
