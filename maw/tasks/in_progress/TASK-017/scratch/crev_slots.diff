+    fn resume_sends(ops: &[Op]) -> Vec<(i64, Option<serde_json::Value>)> {
+        let mut message_id = 1000;
+        let mut found = Vec::new();
+        for op in ops {
+            if let Op::Send {
+                text, reply_markup, ..
+            } = op
+            {
+                if text.starts_with("Сессия ") && text.contains("claude --resume") {
+                    found.push((message_id, reply_markup.clone()));
+                }
+                message_id += 1;
+            }
+        }
+        found
+    }
