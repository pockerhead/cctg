+    fn drain(from_hub: &mut mpsc::Receiver<HubMsg>) -> Vec<i64> {
+        let mut ids = Vec::new();
+        while let Ok(msg) = from_hub.try_recv() {
+            if let HubMsg::Inbound { meta, .. } = msg {
+                ids.push(meta["message_id"].parse().unwrap());
+            }
+        }
+        ids
+    }
