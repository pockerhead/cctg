+        );
+        std::fs::write(dir.path().join(DEVICES_FILE), twice).unwrap();
+        assert_eq!(
+            Devices::open(dir.path(), None).err(),
+            Some(LoadError::Invalid)
+        );
+    }
+
+    #[test]
+    fn names_are_cleaned() {
+        assert_eq!(clean_name("  "), "device");
