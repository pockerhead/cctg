+        &agent_addr,
+        "--hook-addr",
+        &hook_addr,
+    ]);
+    assert!(output.status.success(), "{text}");
+    assert!(!text.contains(SECRET), "the secret was printed: {text}");
+    assert!(text.contains("took the secret"), "cctg doctor: {text}");
+    assert!(asked.lock().unwrap().contains(&"/SHA256SUMS".to_owned()));
