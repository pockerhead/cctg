+    let conf = run.cctg_dir().join("claude");
+    let mcp: Value =
+        serde_json::from_slice(&std::fs::read(conf.join("mcp.json")).unwrap()).unwrap();
+    let server = &mcp["mcpServers"]["cctg"];
