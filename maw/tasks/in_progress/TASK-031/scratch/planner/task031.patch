+#[test]
+fn the_script_has_unix_line_endings() {
+    // A CRLF checkout (core.autocrlf on Windows) breaks `sh`; .gitattributes
+    // keeps it LF.
+    assert!(!install_sh().contains(&b'\r'));
+}
