--- a/crates/cctg/Cargo.toml
+++ b/crates/cctg/Cargo.toml
@@ -14,6 +14,10 @@
 clap.workspace = true
 dotenvy.workspace = true
 reqwest.workspace = true
+# TLS of the agent link and the hook endpoint (TASK-035). Both already in the
+# lock file through reqwest, with the same aws-lc-rs provider.
+rustls = { version = "0.23", default-features = false, features = ["aws_lc_rs", "std"] }
+tokio-rustls = { version = "0.26", default-features = false, features = ["aws_lc_rs"] }
 serde.workspace = true
 serde_json.workspace = true
 subtle.workspace = true
@@ -32,6 +36,8 @@
 
 [dev-dependencies]
 tokio = { workspace = true, features = ["test-util"] }
+# Self-signed certificates for the TLS tests (TASK-035).
+rcgen = { version = "0.14", default-features = false, features = ["aws_lc_rs", "pem"] }
 
