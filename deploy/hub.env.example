# Copy to hub.env next to compose.yml, fill in, chmod 600. Never commit it.
CCTG_BOT_TOKEN=
CCTG_CHAT_ID=-100
CCTG_ALLOWED_USER_IDS=
# 16+ visible ASCII characters. The shared secret of older devices; new
# devices join with a one-time code and get their own secret
# (docs/remote-hub.md, "Устройства и коды").
CCTG_HUB_SECRET=
# Once every device has its own secret (/devices in Telegram shows who
# still uses this one): CCTG_SHARED_SECRET=off, then restart the hub.
# CCTG_SHARED_SECRET=on
# Only when Telegram is reachable just through a proxy (docs/remote-hub.md):
# HTTPS_PROXY=http://127.0.0.1:10809
